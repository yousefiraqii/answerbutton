# انسخ الملف ده لـ .env واملأ القيم (لا ترفعه على Git أبداً)
PORT=3000

# مفتاح Groq/OpenAI — الأفضل يتحط هنا بدل settings.json
GROQ_API_KEY=
# بديل: API_KEY=
# PROVIDER_BASE_URL=https://api.groq.com/openai/v1
# MODEL=openai/gpt-oss-20b

# حماية صفحات الإعدادات ورفع PDF (اختياري لكن مهم أونلاين)
ADMIN_TOKEN=change-me-to-a-long-random-string
# لو true الإضافة نفسها هتحتاج التوكن
REQUIRE_TOKEN_FOR_SOLVE=false

# مجلد البيانات (في Render مع Disk بيكون /var/data)
DATA_DIR=.

# دومينات مسموحة (اختياري)
ALLOWED_ORIGINS=*
